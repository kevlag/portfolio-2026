# ==========================================================================
# Configuration Apache (hébergement web OVH) — remplace vercel.json.
# À déposer à la racine du dossier du site (celui du multisite kevinlagier.com).
# ==========================================================================

# ---- HTTPS + domaine unique (https://kevinlagier.com, sans www) ----
RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://kevinlagier.com%{REQUEST_URI} [L,R=301]

# ---- Anciennes URLs Webflow -> nouvelles pages (redirections permanentes) ----
RewriteRule ^about/?$ /about.html [L,R=301]
RewriteRule ^kevin-lagier-digital-art-director-design-playground/?$ / [L,R=301]
RewriteRule ^work/?$ / [L,R=301]
RewriteRule ^work/alexandre-pichoux/?$ /alexandrepichoux.html [L,R=301]
RewriteRule ^work/bobby-buddy/?$ /bobbybuddy.html [L,R=301]
RewriteRule ^work/elium-studio/?$ /eliumstudio.html [L,R=301]
RewriteRule ^work/lacourte-raquin-tatar/?$ /lacourte.html [L,R=301]
RewriteRule ^work/michael-jackson-kevin-lagier-digital-art-director-design/?$ /michaeljackson.html [L,R=301]
RewriteRule ^work/mind-games/?$ /mindgames.html [L,R=301]
RewriteRule ^work/power-z/?$ /powerz.html [L,R=301]
RewriteRule ^work/salon-peugeot-kevin-lagier-digital-art-director-design/?$ /peugeot.html [L,R=301]
RewriteRule ^work/schlouk/?$ /schlouk.html [L,R=301]
RewriteRule ^work/studio-boam-kevin-lagier-digital-art-director-design/?$ /studioboam.html [L,R=301]
RewriteRule ^work/tag-heuer(-connected-calibre-5-kevin-lagier-digital-art-director-design)?/?$ /tagheuer.html [L,R=301]
# Ancien projet qui n'existe plus dans le nouveau portfolio -> accueil
RewriteRule ^work/e-shop-beauty-care/?$ / [L,R=301]

# ---- Types de fichiers (au cas où le serveur ne les connaîtrait pas) ----
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
</IfModule>

# ---- Compression du texte ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ---- Projets non référencés (Renault The Originals Store, Sovera) ----
# La page, son CSS, ses images, ses visuels de la Home et sa vidéo reçoivent
# X-Robots-Tag (en plus de la balise meta robots de la page).
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(sovera|theoriginalsstore)(\.html)?$" NOINDEX
  SetEnvIf Request_URI "^/css/pages/(sovera|theoriginalsstore)\.css$" NOINDEX
  SetEnvIf Request_URI "^/images/(sovera|theoriginalsstore)/" NOINDEX
  SetEnvIf Request_URI "^/images/home/(sovera|theoriginalsstore)-" NOINDEX
  SetEnvIf Request_URI "^/images/home/hero-(desktop|mobile)-(08|13)\.webp$" NOINDEX
  SetEnvIf Request_URI "^/videos/theoriginalsstore/" NOINDEX
  SetEnvIf Request_URI "^/(images|videos)/" CACHE_MEDIA
  SetEnvIf Request_URI "^/fonts/" CACHE_FONT
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, noarchive, nosnippet, noimageindex" env=NOINDEX
  # ---- Cache : polices 1 an, images et vidéos 1 jour ----
  Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE_FONT
  Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800" env=CACHE_MEDIA
</IfModule>
