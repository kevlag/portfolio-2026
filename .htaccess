# ==========================================================================
# Configuration Apache (hébergement web OVH) — remplace vercel.json.
# À déposer à la racine du dossier du site (celui du multisite kevinlagier.com).
# ==========================================================================

# ---- Pas de liste de fichiers quand on ouvre un dossier (ex. /images/) ----
Options -Indexes -MultiViews
# Si le serveur ignorait l'option ci-dessus, la liste serait au moins vide.
IndexIgnore *

# ---- HTTPS + domaine unique (https://kevinlagier.com, sans www) ----
RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://kevinlagier.com%{REQUEST_URI} [L,R=301]

# ---- Anciennes URLs Webflow -> nouvelles pages (redirections permanentes) ----
RewriteRule ^about/?$ https://kevinlagier.com/about.html [L,R=301]
RewriteRule ^kevin-lagier-digital-art-director-design-playground/?$ https://kevinlagier.com/ [L,R=301]
RewriteRule ^work/?$ https://kevinlagier.com/ [L,R=301]
RewriteRule ^work/alexandre-pichoux/?$ https://kevinlagier.com/alexandrepichoux.html [L,R=301]
RewriteRule ^work/bobby-buddy/?$ https://kevinlagier.com/bobbybuddy.html [L,R=301]
RewriteRule ^work/elium-studio/?$ https://kevinlagier.com/eliumstudio.html [L,R=301]
RewriteRule ^work/lacourte-raquin-tatar/?$ https://kevinlagier.com/lacourte.html [L,R=301]
RewriteRule ^work/michael-jackson-kevin-lagier-digital-art-director-design/?$ https://kevinlagier.com/michaeljackson.html [L,R=301]
RewriteRule ^work/mind-games/?$ https://kevinlagier.com/mindgames.html [L,R=301]
RewriteRule ^work/power-z/?$ https://kevinlagier.com/powerz.html [L,R=301]
RewriteRule ^work/salon-peugeot-kevin-lagier-digital-art-director-design/?$ https://kevinlagier.com/peugeot.html [L,R=301]
RewriteRule ^work/schlouk/?$ https://kevinlagier.com/schlouk.html [L,R=301]
RewriteRule ^work/studio-boam-kevin-lagier-digital-art-director-design/?$ https://kevinlagier.com/studioboam.html [L,R=301]
RewriteRule ^work/tag-heuer(-connected-calibre-5-kevin-lagier-digital-art-director-design)?/?$ https://kevinlagier.com/tagheuer.html [L,R=301]
# Ancien projet qui n'existe plus dans le nouveau portfolio -> accueil
RewriteRule ^work/e-shop-beauty-care/?$ https://kevinlagier.com/ [L,R=301]

# ---- Types de fichiers (au cas où le serveur ne les connaîtrait pas) ----
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
</IfModule>

# ---- Compression du texte ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ---- Projets non référencés (Renault The Originals Store, Sovera) ----
# La page, son CSS, ses images, ses visuels de la Home et sa vidéo reçoivent
# X-Robots-Tag (en plus de la balise meta robots de la page).
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(sovera|theoriginalsstore)(\.html)?$" NOINDEX
  SetEnvIf Request_URI "^/css/pages/(sovera|theoriginalsstore)\.css$" NOINDEX
  SetEnvIf Request_URI "^/images/(sovera|theoriginalsstore)/" NOINDEX
  SetEnvIf Request_URI "^/images/home/(sovera|theoriginalsstore)-" NOINDEX
  SetEnvIf Request_URI "^/images/home/hero-(desktop|mobile)-(08|13)\.webp$" NOINDEX
  SetEnvIf Request_URI "^/videos/theoriginalsstore/" NOINDEX
  SetEnvIf Request_URI "^/(images|videos)/" CACHE_MEDIA
  SetEnvIf Request_URI "^/fonts/" CACHE_FONT
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, noarchive, nosnippet, noimageindex" env=NOINDEX
  # ---- Cache : polices 1 an, images et vidéos 1 jour ----
  Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE_FONT
  Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800" env=CACHE_MEDIA
</IfModule>
